{
  "name": "ol-sld-styler-examples",
  "version": "1.0.0",
  "description": "Examples to demonstrate ol-sld-styler NPM module",
  "private": true,
  "scripts": {
    "watch": "webpack --watch",
    "start-basic": "webpack serve --open basic_example.html --config-name basic",
    "start-sldfiles": "webpack serve --open sld_files_example.html --config-name sldfiles",
    "start-layersw": "webpack serve --open layersw_example.html --config-name layersw",
    "start-legend": "webpack serve --open legend_example.html --config-name legend",
    "start-full": "webpack serve --open full_example.html --config-name full",
    "start-styles": "webpack serve --open qgisstyles_example.html --config-name qgisstyles",
    "build": "webpack",
    "sql-install": "cp node_modules/sql.js/dist/sql-wasm.wasm dist"
  },
  "author": "Richard Thomas",
  "license": "ISC",
  "devDependencies": {
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "ol-layerswitcher": "^4.1.1",
    "ol-load-geopackage": "^2.3.1",
    "ol-sld-styler": "^2.0.0",
    "proj4": "^2.9.2"
  },
  "peerDependencies": {
    "ol": ">=7.0.0"
  }
}
